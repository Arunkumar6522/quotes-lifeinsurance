ers. Free quotes, no fees, expert advice from AMF licensed brokers. Serving Montreal, Quebec &amp; all of Canada.\"/><meta property=\"og:url\" content=\"https://quotes-lifeinsurance.com\"/><meta property=\"og:site_name\" content=\"Quotes Life Insurance\"/><meta property=\"og:locale\" content=\"en_CA\"/><meta property=\"og:image\" content=\"https://quotes-lifeinsurance.com/og-image.png\"/><meta property=\"og:image:width\" content=\"1200\"/><meta property=\"og:image:height\" content=\"630\"/><meta property=\"og:image:alt\" content=\"Quotes Life Insurance - Free Life Insurance Quotes in Canada\"/><meta property=\"og:locale:alternate\" content=\"fr_CA\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary_large_image\"/><meta name=\"twitter:title\" content=\"Quotes Life Insurance | Free Life Insurance Quotes in Canada\"/><meta name=\"twitter:description\" content=\"Compare 20+ top Canadian life insurance carriers. Free quotes, no fees, expert advice from AMF licensed brokers.\"/><meta name=\"twitter:image\" content=\"https://quotes-lifeinsurance.com/og-image.png\"/><meta name=\"twitter:image:alt\" content=\"Quotes Life Insurance - Free Life Insurance Quotes in Canada\"/><meta name=\"twitter:image:width\" content=\"1200\"/><meta name=\"twitter:image:height\" content=\"630\"/><link rel=\"shortcut icon\" href=\"/favicon.png\"/><link rel=\"icon\" href=\"/favicon.ico?favicon.2vob68tjqpejf.ico\" sizes=\"256x256\" type=\"image/x-icon\"/><link rel=\"icon\" href=\"/favicon.png\"/><link rel=\"apple-touch-icon\" href=\"/favicon.png\"/><meta name=\"next-size-adjust\" content=\"\"/><link rel=\"preconnect\" href=\"https://form.questionscout.com\"/><link rel=\"preconnect\" href=\"https://cdn.questionscout.com\"/><link rel=\"dns-prefetch\" href=\"https://form.questionscout.com\"/><link rel=\"dns-prefetch\" href=\"https://cdn.questionscout.com\"/><link rel=\"preload\" href=\"https://form.questionscout.com/616e35ca63bd79140f61b3ef\" as=\"document