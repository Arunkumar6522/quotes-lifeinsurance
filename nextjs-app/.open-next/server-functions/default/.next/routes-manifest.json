{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "onMatchHeaders": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/articles/[slug]",
      "regex": "^/articles/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/articles/(?<nxtPslug>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_global-error",
      "regex": "^/_global\\-error(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_global\\-error(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/about",
      "regex": "^/about(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/about(?:/)?$"
    },
    {
      "page": "/api/google-reviews",
      "regex": "^/api/google\\-reviews(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/google\\-reviews(?:/)?$"
    },
    {
      "page": "/articles",
      "regex": "^/articles(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/articles(?:/)?$"
    },
    {
      "page": "/careers",
      "regex": "^/careers(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/careers(?:/)?$"
    },
    {
      "page": "/contact",
      "regex": "^/contact(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/contact(?:/)?$"
    },
    {
      "page": "/favicon.ico",
      "regex": "^/favicon\\.ico(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/favicon\\.ico(?:/)?$"
    },
    {
      "page": "/foresters",
      "regex": "^/foresters(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/foresters(?:/)?$"
    },
    {
      "page": "/manulife",
      "regex": "^/manulife(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/manulife(?:/)?$"
    },
    {
      "page": "/privacy-policy",
      "regex": "^/privacy\\-policy(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/privacy\\-policy(?:/)?$"
    },
    {
      "page": "/quote-calculator",
      "regex": "^/quote\\-calculator(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/quote\\-calculator(?:/)?$"
    },
    {
      "page": "/services/critical-illness",
      "regex": "^/services/critical\\-illness(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/services/critical\\-illness(?:/)?$"
    },
    {
      "page": "/services/disability",
      "regex": "^/services/disability(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/services/disability(?:/)?$"
    },
    {
      "page": "/services/term-life",
      "regex": "^/services/term\\-life(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/services/term\\-life(?:/)?$"
    },
    {
      "page": "/services/universal-life",
      "regex": "^/services/universal\\-life(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/services/universal\\-life(?:/)?$"
    },
    {
